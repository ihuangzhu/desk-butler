<Window x:Class="DeskButler.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskButler 本地管家" Width="840" Height="560"
        MinWidth="700" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="DeskButler" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="本地工作现场管家" Foreground="#FF66666F" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Foreground="#FF276749" VerticalAlignment="Bottom"
                       HorizontalAlignment="Right" />
        </DockPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Background="White" Padding="8">
            <TabItem x:Name="HomeTabItem" Header="首页">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="你的现场由本机保存，重启后可由你手动恢复。" FontSize="16" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="立即保存现场" Command="{Binding SaveNowCommand}" Padding="16,8" Margin="0,0,10,0" />
                            <Button Content="{Binding CaptureToggleText}" AutomationProperties.Name="切换捕获" Command="{Binding ToggleCaptureCommand}" Padding="16,8" />
                        </StackPanel>
                        <Border x:Name="ResidentCandidateConfirmationPanel" Focusable="True" KeyboardNavigation.IsTabStop="True"
                                BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="发现的常驻应用" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="确认后才会在登录后按你保存的顺序启动。" Foreground="#FF66666F" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ResidentCandidates}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFE4E4E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="32" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="{Binding DisplayName}" />
                                                    <Image Grid.Column="2" Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Focusable="False" />
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Confidence}" Foreground="#FF66666F" Margin="0,2,0,0" />
                                                        <TextBlock Text="低可信，默认不添加" Foreground="#FFB45309" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Confidence}" Value="Low"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <TextBlock Text="发现可能的新路径，需要你确认" Foreground="#FFB45309" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="PathReplacement"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <TextBlock Text="{Binding PathReplacementText}" TextWrapping="Wrap" Foreground="#FF66666F" />
                                                        <TextBlock Text="请选择主程序 .exe" Foreground="#FFB42318" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding NeedsLaunchPath}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <Button DockPanel.Dock="Right" Content="浏览修正" Command="{Binding BrowsePathCommand}" Margin="8,0,0,0" />
                                                            <TextBox Text="{Binding FinalLaunchPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsTabStop="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ToolTip="可修改为主程序 .exe 路径" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="确认添加" Command="{Binding ConfirmResidentCandidatesCommand}" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="本次忽略" Command="{Binding DismissResidentCandidatesCommand}" Padding="12,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="现场">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="最近 3 次现场" FontSize="18" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Padding="12,4" />
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding RecentScenes}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE4E4E7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="恢复" Padding="14,6"
                                                Command="{Binding DataContext.RestoreSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CapturedAtText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemCountText}" Foreground="#FF71717A" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="模块">
                <TextBlock Margin="18" Text="{Binding ModuleStatusText}" FontSize="16" TextWrapping="Wrap" />
            </TabItem>
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="捕获与排除设置会保存在当前 Windows 用户目录。" TextWrapping="Wrap" />
                        <CheckBox Content="登录 Windows 后自动启动 DeskButler" IsChecked="{Binding IsStartupEnabled, Mode=OneWay}" Command="{Binding ToggleStartupCommand}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding StartupErrorMessage}" Margin="0,6,0,0" Foreground="#FFB42318" TextWrapping="Wrap" />
                        <TextBlock Text="常驻应用" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="启用常驻应用" AutomationProperties.Name="启用或停用常驻应用"
                                      IsChecked="{Binding ResidentApplicationsEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleResidentApplicationsCommand}" Margin="0,0,8,0" />
                            <Button Content="查找常驻应用" Command="{Binding FindResidentCandidatesCommand}" Margin="0,0,8,0" />
                            <Button Content="浏览添加应用" Command="{Binding AddResidentApplicationCommand}" Margin="0,0,8,0" />
                            <Button Content="立即启动常驻应用" Command="{Binding LaunchResidentsNowCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ResidentApplications}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE4E4E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" Focusable="False" />
                                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBox Text="{Binding LaunchPath, Mode=OneWay}" IsReadOnly="True" IsTabStop="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" />
                                                <TextBlock Text="{Binding PathStatusText}" Foreground="#FF66666F" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="2">
                                                <Button Content="启用" Command="{Binding EnableCommand}" CommandParameter="True" />
                                                <Button Content="停用" Command="{Binding EnableCommand}" CommandParameter="False" />
                                                <Button Content="上移" Command="{Binding MoveUpCommand}" />
                                                <Button Content="下移" Command="{Binding MoveDownCommand}" />
                                                <Button Content="替换路径" Command="{Binding ReplacePathCommand}" />
                                                <Button Content="删除" Command="{Binding RemoveCommand}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="永久排除列表" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <ListBox ItemsSource="{Binding ExcludedExecutablePaths}" MinHeight="80" MaxHeight="220" BorderBrush="#FFE4E4E7" Padding="8" />
                        <TextBlock Text="新的排除项可在恢复卡片中逐项设置。" Margin="0,8,0,0" Foreground="#FF66666F" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="诊断">
                <StackPanel Margin="18">
                    <TextBlock Text="健康状态" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HealthStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Button Content="预览诊断内容" Command="{Binding LoadDiagnosticsCommand}"
                            Padding="14,6" Margin="0,18,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="诊断包只包含白名单日志和健康清单，不收集屏幕、键盘、剪贴板或文档内容。"
                               Foreground="#FF66666F" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBox Text="{Binding DiagnosticPreviewText, Mode=OneWay}" Margin="0,10,0,0" MinHeight="130"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
